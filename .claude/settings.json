{
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(volta *)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "WebSearch",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:tauri.app)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:github.com)",
      "Bash(gh repo *)"
    ]
  },
  "mcpServers": {
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@berthojoris/mcp-sqlite-server"
      ]
    }
  }
}
